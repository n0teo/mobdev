<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Нажатая: кнопка «вдавлена» на место тени -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gb_dark" />
                    <stroke android:width="3dp" android:color="@color/gb_darkest" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Обычная: тень снизу-справа + кнопка поверх -->
    <item>
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gb_darkest" />
                </shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gb_light" />
                    <stroke android:width="3dp" android:color="@color/gb_darkest" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>