<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="start"
        android:fontFamily="sans-serif"
        android:gravity="end|bottom"
        android:maxLines="1"
        android:padding="8dp"
        android:textSize="48sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <Button
            android:id="@+id/btn_clear"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/clear" />

        <Button
            android:id="@+id/btn_backspace"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/backspace" />

        <Button
            android:id="@+id/btn_sign"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/sign" />

        <Button
            android:id="@+id/btn_divide"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/divide" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <Button
            android:id="@+id/btn_7"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/digit_7" />

        <Button
            android:id="@+id/btn_8"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/digit_8" />

        <Button
            android:id="@+id/btn_9"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/digit_9" />

        <Button
            android:id="@+id/btn_multiply"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/multiply" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <Button
            android:id="@+id/btn_4"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/digit_4" />

        <Button
            android:id="@+id/btn_5"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/digit_5" />

        <Button
            android:id="@+id/btn_6"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/digit_6" />

        <Button
            android:id="@+id/btn_minus"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/minus" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <Button
            android:id="@+id/btn_1"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/digit_1" />

        <Button
            android:id="@+id/btn_2"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/digit_2" />

        <Button
            android:id="@+id/btn_3"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/digit_3" />

        <Button
            android:id="@+id/btn_plus"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/plus" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <Button
            android:id="@+id/btn_0"
            style="@style/CalcButton"
            android:layout_weight="2"
            android:fontFamily="sans-serif"
            android:text="@string/digit_0" />

        <Button
            android:id="@+id/btn_dot"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/dot" />

        <Button
            android:id="@+id/btn_equals"
            style="@style/CalcButton"
            android:fontFamily="sans-serif"
            android:text="@string/equals" />
    </LinearLayout>

</LinearLayout>